{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheets Monitor",
  "version": "1.0.2",
  "identifier": "com.sheetsmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheets Monitor",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../distribution/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../distribution/rust-notices/": "rust-notices/",
      "../docs/installation.md": "INSTALLATION.md"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    },
    "shortDescription": "Monitoramento contínuo de integridade",
    "category": "Productivity",
    "license": "MIT"
  }
}
