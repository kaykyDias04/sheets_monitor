root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{rs,py,ps1,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[docs/evidence/**]
trim_trailing_whitespace = false
insert_final_newline = false

[archive/**]
trim_trailing_whitespace = false
insert_final_newline = false
